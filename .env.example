# ANTHROPIC_API_KEY: Required for Claude AI API calls.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Optional. Only used for the opt-in "Redactar síntesis con IA"
# button in the comparative-law search (never called automatically).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="anthropic/claude-3.5-haiku"
