# ANTHROPIC_API_KEY: Required for Claude AI API calls.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Optional. Only used for the opt-in "Redactar síntesis con IA"
# button in the comparative-law search (never called automatically).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="anthropic/claude-3.5-haiku"

# ---------------------------------------------------------------------------
# PIZARRA ATP (opcional). Ver README, sección "Despliegue en servidores propios".
# ---------------------------------------------------------------------------
# Fuente de datos: demo (por defecto, datos ficticios) | archivo
PIZARRA_FUENTE=demo
# Con PIZARRA_FUENTE=archivo: ruta a un CSV o JSON con las investigaciones
# (por ejemplo una exportación periódica del SUP en una carpeta del servidor).
# Valores múltiples en una celda (boletines, palabras_clave, normas) se separan con |
PIZARRA_ARCHIVO=
# Opcional: CSV con las comisiones que sigue cada investigador/a (investigador;area;comision).
PIZARRA_ASIGNACIONES_ARCHIVO=
# Carpeta del servidor donde se guardan las importaciones hechas desde la pantalla.
# Sin esto quedan solo en memoria y se pierden al reiniciar.
PIZARRA_DATA_DIR=
# Si se define, toda la API /pizarra exige este token (cabecera x-pizarra-token).
PIZARRA_TOKEN=
# true = oculta el nombre del solicitante en pedidos de parlamentarios.
PIZARRA_OCULTAR_SOLICITANTE=false

# Muestra la Pizarra ATP en el menú (por ahora oculta). Se aplica al compilar el frontend.
VITE_PIZARRA_VISIBLE=false
