{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/registro-sesiones/sincronizar",
      "schedule": "23 11 * * *"
    },
    {
      "path": "/api/transcripcion/automatica/paso",
      "schedule": "47 12 * * *"
    }
  ]
}